# Allowlist: the build context holds only what the Dockerfile copies. Anything
# new (env files, operator notes, keys, local data) stays out by default.
*

!package.json
!package-lock.json
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.md
!apps/server/**
!apps/web/**
!apps/renderer/**
!packages/**
!scripts/*.ts
!scripts/polka-publish.mjs
!deploy/migrations/*.sql
!content/editorial/**
# The web bundle embeds the privacy policy and terms from here.
!docs/legal/*.md
# ...and the «На Полку» bookmark, built from its source and the extension's readers.
!extensions/bookmarklet/build.ts
!extensions/bookmarklet/src/**
!extensions/chrome/src/extract/**
!extensions/chrome/src/shared/**

# Development and acceptance tools never run inside the image.
scripts/test-*
scripts/restore-drill*
scripts/seed-design-demo.ts
scripts/url-import-browser-check.ts
scripts/capture-via-mcp.ts
scripts/prepare-capture.ts
scripts/editorial-static-snapshots.ts
**/*.test.ts
**/node_modules
**/__pycache__

# Secrets can never enter the context, even inside an allowed directory.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.local
**/.DS_Store
