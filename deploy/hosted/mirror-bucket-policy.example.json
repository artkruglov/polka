{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "mirror-writer-no-version-deletes",
      "Effect": "Allow",
      "Principal": {"CanonicalUser": "<ID сервисного аккаунта копии>"},
      "Action": ["s3:ListBucket", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": ["arn:aws:s3:::<MIRROR_BUCKET>", "arn:aws:s3:::<MIRROR_BUCKET>/*"]
    },
    {
      "Sid": "mirror-reader",
      "Effect": "Allow",
      "Principal": {"CanonicalUser": "<ID сервисного аккаунта чтения копии>"},
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": ["arn:aws:s3:::<MIRROR_BUCKET>", "arn:aws:s3:::<MIRROR_BUCKET>/*"]
    }
  ]
}
