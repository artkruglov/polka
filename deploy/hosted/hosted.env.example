# Copy to deploy/hosted/hosted.env on the server (chmod 600). Never commit it.
APP_HOST=polochka.app
# Interactive HTML viewer: a separate registrable domain used only by the viewer.
# Its A record must point at this VM before HTML_LIVE_MODE=production (TLS is
# issued by Caddy on first start either way).
VIEWER_HOST_NAME=polochka.page
# disabled (static HTML only) | production (interactive viewer on VIEWER_HOST_NAME).
# Rollback: set disabled and `docker compose up -d`.
HTML_LIVE_MODE=disabled
# Image built from a tagged commit, e.g. polka:v0.1.0-rc.2 (record its image ID).
POLKA_IMAGE=
# openssl rand -hex 24 for each password; openssl rand -hex 32 for LINK_KEY.
POSTGRES_ADMIN_PASSWORD=
POLKA_SCHEMA_PASSWORD=
POLKA_RUNTIME_PASSWORD=
# Keep LINK_KEY stable and backed up separately: changing it breaks every share link.
LINK_KEY=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=polka-staging-objects
BACKUP_BUCKET=polka-staging-backups
MAIL_MODE=disabled
