# Copy to deploy/hosted/hosted.env on the server (chmod 600). Never commit it,
# and keep the authoritative copy in a secret manager or offline, not in any
# bucket this installation writes to.
APP_HOST=polka.example.com
# Source code offered to this installation's users (AGPL-3.0 § 13): the footer
# link «Открытый код на GitHub», /llms.txt and /connect. If you run a MODIFIED
# Полка, you must set this to an https URL of your modified source (or hold a
# commercial license, COMMERCIAL.md). Empty: https://github.com/artkruglov/polka.
SOURCE_URL=
# Interactive HTML viewer: a separate registrable domain used only by the
# viewer (VIEWER_ORIGIN becomes https://$VIEWER_HOST_NAME). Required even when
# HTML_LIVE_MODE=disabled. Its A record must point at this VM before the first
# `up`: Caddy requests TLS for both hosts on first start.
VIEWER_HOST_NAME=polka-viewer.example.net
# disabled (static HTML only) | production (interactive viewer on VIEWER_HOST_NAME).
# Rollback: set disabled and `docker compose --env-file hosted.env up -d`.
HTML_LIVE_MODE=disabled
# Image built from a tagged commit, e.g. polka:<tag> (record its image ID).
POLKA_IMAGE=
# openssl rand -hex 24 for each password; openssl rand -hex 32 for LINK_KEY.
POSTGRES_ADMIN_PASSWORD=
POLKA_SCHEMA_PASSWORD=
POLKA_RUNTIME_PASSWORD=
# Keep LINK_KEY stable and stored in your secret manager: changing or losing
# it breaks every share link.
LINK_KEY=
# S3-compatible object storage (private, versioning enabled).
S3_ENDPOINT=https://s3.example.com
# Region for the backup client; many S3-compatible providers accept us-east-1.
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=polka-objects
# Separate private, versioned bucket for database dumps.
BACKUP_BUCKET=polka-backups
# Dedicated key for the backup job: write-only (PutObject) on BACKUP_BUCKET and
# nothing else. If empty, the app key above is used as a fallback.
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# BACKUP_INTERVAL_SECONDS=86400
# Token for GET /api/ops/status (external monitoring): openssl rand -hex 32.
# Empty: the route does not exist. The app key must be able to list
# BACKUP_BUCKET for the backup-age check.
OPS_STATUS_TOKEN=
# disabled | smtp: sign-in by emailed code.
MAIL_MODE=disabled
# invite (default here): codes go only to accounts that already have this
# address (npm run account:email) and to EMAIL_SIGNUP_ALLOW entries, which get a
# new shelf. open: anyone who enters an address gets a shelf.
EMAIL_SIGNUP=invite
# Addresses and @domains, comma-separated: anna@example.com,@team.example.com
EMAIL_SIGNUP_ALLOW=
# New shelves by email per day: for the whole installation and per client IP.
# 0 closes sign-up; existing accounts keep signing in.
EMAIL_SIGNUP_DAILY_LIMIT=50
EMAIL_SIGNUP_DAILY_PER_IP=3
# Anti-spam: new shelves per day from one /24 network (IPv6 /48) and per mail
# domain other than the large public providers (Яндекс, Mail.ru, Gmail…).
EMAIL_SIGNUP_DAILY_PER_SUBNET=10
EMAIL_SIGNUP_DAILY_PER_DOMAIN=20
# Sign-in rules (docs/specs/SIGN_IN_PROVIDERS.md). ч. 10 ст. 8 149-ФЗ: users
# in Russia sign in through a Russian system. A NEW shelf by an emailed code
# opens only on Russian mail domains (ru-only: Яндекс, Mail.ru, Рамблер, VK
# and this installation's domain); any | ru-only | a list of domains.
EMAIL_SIGNUP_DOMAINS=ru-only
# any: existing accounts on other domains (Gmail) keep their codes.
# signup: stop that too — first ask them to link Яндекс ID or VK ID.
EMAIL_LOGIN_DOMAINS=any
# Яндекс ID (oauth.yandex.ru): redirect URI https://$APP_HOST/api/auth/idp/yandex/callback,
# scopes login:email and login:info. Both values empty: the button is hidden.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID (id.vk.ru, web app): trusted redirect URL
# https://$APP_HOST/api/auth/idp/vk/callback, access to email. Empty: hidden.
VK_CLIENT_ID=
# Organisation access: verified addresses of a domain join a template
# library on sign-in, e.g. company.ru=<library uuid>:reader (never admin).
ORG_DOMAINS=
# Comments: owner-notes (only a work's owner writes notes; recipients read,
# no recipient comments, reactions or letters) | on | off.
COMMENTS_MODE=owner-notes
# Abuse protection (docs/specs/ABUSE_PROTECTION.md, deploy/hosted/README.md
# «Модерация»). Which new links wait for the operator before their first open:
#   off           never;
#   auto          nobody is approved by hand: the content filter decides
#                 every link (docs/specs/CONTENT_FILTER.md); only images of a
#                 new account that no model has seen wait. Trust is automatic
#                 (age, TRUST_MIN_CLEAN_SAVES clean saves, no reports).
#                 polochka.app;
#   flagged       a page that looks like phishing from an author who is not
#                 trusted yet (a trusted author's link opens, you get a letter);
#   new-accounts  any link of an account that is not trusted yet, plus the
#                 above: the operator approves a person's first link;
#   all           any link of an account that signed up by email (pilots).
SHARE_MODERATION=auto
TRUST_MIN_CLEAN_SAVES=3
# Prohibited-content filter (docs/specs/CONTENT_FILTER.md, deploy/hosted/README.md
# «Модерация»). strict: anything flagged waits for the operator whoever the
# author is. AUTOBLOCK=false for the first 2–4 weeks: only CSAM and certain
# malicious code are blocked at once; then true (a severe category the rules
# score high, or both models agree on, is blocked and isolated).
CONTENT_FILTER_MODE=strict
CONTENT_FILTER_AUTOBLOCK=false
# Per category: <category>=<days>|keep|manual over the defaults (csam,
# extremism, drugs, weapons, authorities' demands 90 days; porn, personal
# data, fraud, code 30; soft categories and copyright keep: links closed,
# the owner keeps the work).
MODERATION_RETENTION=
# Where an owner appeals a block (shown on their shelf).
OPERATOR_CONTACT=privacy@polochka.app
# The model stage (docs/specs/CONTENT_FILTER.md, «Модели»): providers whose
# data stays in Russia only. Primary: NeuralDeep, models on its own hardware
# in Russia (only those in CONTENT_MODEL_ND_ALLOWED start; its wallet models
# may be served abroad). Fallback: Yandex AI Studio, also the second opinion.
# Before production: NeuralDeep's legal details and a processing agreement
# (поручение, ч. 3 ст. 6 152-ФЗ) — see the spec. Model names are the
# benchmark's choice (Polka-private/model-bench), changed here only. Keys
# are secrets: here and in Lockbox, never in the repository.
CONTENT_MODEL_PROVIDER=neuraldeep
# Unset: https://api.neuraldeep.ru/v1/chat/completions (the only host allowed).
CONTENT_MODEL_URL=
# -noreason: thinking already off on NeuralDeep's side. With a reasoning
# variant (qwen3.6-35b-a3b) add {"chat_template_kwargs":{"enable_thinking":false}}.
CONTENT_MODEL_PRIMARY=qwen3.6-35b-a3b-noreason
CONTENT_MODEL_PRIMARY_OPTIONS=
CONTENT_MODEL_API_KEY=
# NeuralDeep plan limits per key (free: 20 rpm, 3 parallel; «Qwen ∞»: 30 rpm,
# 3 streams). A 429 or a full minute sends the question to the fallback.
CONTENT_MODEL_RPM=20
CONTENT_MODEL_MAX_CONCURRENCY=3
# true for a flat-rate key («Qwen ∞»): its calls cost 0 for the budget.
CONTENT_MODEL_FLAT_RATE=false
CONTENT_MODEL_FALLBACK_PROVIDER=yandex
CONTENT_MODEL_FALLBACK_URL=https://llm.api.cloud.yandex.net/v1/chat/completions
CONTENT_MODEL_FALLBACK=gpt://<folder>/gpt-oss-120b/latest
CONTENT_MODEL_FALLBACK_OPTIONS={"reasoning_effort":"low"}
# The AI Studio key (also used by CONTENT_VISION_MODERATION).
CONTENT_MODEL_FALLBACK_API_KEY=
# 0: no limit of ours (AI Studio enforces its own quotas).
CONTENT_MODEL_FALLBACK_RPM=0
CONTENT_MODEL_FALLBACK_MAX_CONCURRENCY=0
# The code reviewer: the primary's endpoint, key and limits (unset = inherit).
CONTENT_CODE_MODEL_PROVIDER=
CONTENT_CODE_MODEL=qwen3.6-35b-a3b-noreason
CONTENT_CODE_MODEL_OPTIONS=
CONTENT_CODE_MODEL_URL=
CONTENT_CODE_MODEL_API_KEY=
# Unset: the default list in apps/server/config.ts. Narrow it, never widen it
# without NeuralDeep's written confirmation of where the model runs.
CONTENT_MODEL_ND_ALLOWED=
# ₽ per 1000 tokens (input/cached/output); «neuraldeep:» prices a model on
# that provider only. AI Studio: sync prices with VAT. NeuralDeep: its list
# prices (₽ per 1M in/out: qwen3.6 7.14/40.8, gemma-4-31b 11/37.4,
# gpt-oss-120b 5.1/20.4, qwen3.8-27b 24.48/122.4; cached ×0.1), built in too.
CONTENT_MODEL_PRICES_RUB=qwen3.6-35b-a3b=0.20/0.05/0.30,gpt-oss-120b=0.30/0.30/0.30,deepseek-v4-flash=0.30/0.075/0.50,neuraldeep:qwen3.6=0.00714/0.000714/0.0408,neuraldeep:gemma-4-31b=0.011/0.0011/0.0374,neuraldeep:gpt-oss-120b=0.0051/0.00051/0.0204,neuraldeep:qwen3.8-27b=0.02448/0.002448/0.1224
CONTENT_MODEL_DAILY_BUDGET_RUB=500
CONTENT_MODEL_IMAGES=true
CONTENT_VISION_MODERATION=false
# Where moderation letters go (a held link, a suspicious page, every report,
# an automatic pause), each with one-click actions. Needs MAIL_MODE=smtp.
# Empty: no letters; use npm run moderation:queue / moderation:approve.
OPERATOR_EMAIL=
# Distinct reporters of one link within 7 days that pause it. 0: never.
MODERATION_AUTOPAUSE_REPORTS=3
# An account younger than this (days) that the operator has not approved is
# new: at most NEW_ACCOUNT_MAX_LINKS live links (0: no limit), each for at
# most 7 days. Accounts created by the operator are trusted from the start.
NEW_ACCOUNT_DAYS=7
NEW_ACCOUNT_MAX_LINKS=5
# Links a new account may create per day (closed ones included).
NEW_ACCOUNT_DAILY_LINKS=10
# SMTP for MAIL_MODE=smtp. Yandex Cloud Postbox: host postbox.cloud.yandex.net,
# port 587 (STARTTLS); user and password are the ID and secret of a service
# account API key with scope yc.postbox.send (role postbox.sender).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# A bare address on the verified sending domain, e.g. no-reply@polka.example.com.
MAIL_FROM=
