{
	# No access log: share tokens live in URL fragments, but viewer grants and
	# other capabilities can appear in paths.
	# No admin API: every host-network container could reach it on loopback.
	# Apply Caddyfile changes with `docker compose --env-file hosted.env restart caddy`.
	admin off
	# HTTP is handled per site below: an automatic redirect would carry a
	# viewer capability path in Location.
	auto_https disable_redirects
	servers {
		# The Host header must match the TLS SNI name (421 otherwise).
		strict_sni_host on
		# A client that does not finish its request line and headers in time
		# is dropped: Caddy sets no such limit by default, so slow connections
		# could hold every socket. Bodies keep no timeout, a large upload may be slow.
		timeouts {
			read_header 10s
		}
	}
	# Upstream error entries (http.log.error) embed the full request: URI with
	# a viewer capability, client IP and headers. Keep only Caddy's own
	# operational logs (TLS, config); upstream health is seen via /readyz.
	log default {
		output stderr
		exclude http.log.error
	}
}

http://{$APP_HOST} {
	redir https://{$APP_HOST}{uri} 308
}

{$APP_HOST} {
	# Text only (Caddy's default list). zstd first, gzip for the rest; the
	# stock image has no Brotli encoder.
	encode zstd gzip
	# Bodies stop here, a little above what the app accepts on each route
	# (bodyLimit in apps/server), so an oversized upload gets a 413 from Caddy
	# instead of streaming into the app. The matchers do not overlap: each
	# request meets at most one limit.
	# - a video file of a project (PROJECT_VIDEO_MAX_FILE_BYTES, 200 MiB);
	# - a session's transcript (SESSION_LIMITS.transcriptBytes, 64 MiB);
	# - /api/ext/*: the extension's own routes set their own limits;
	# - everything else: /mcp, the publish API and a session's index take
	#   up to 8 MiB, the rest of the app 5 MiB (MAX_BYTES) or less.
	@video path_regexp video (?i)^/api/v1/projects/[^/]+/media/[0-9]+$
	@transcript path_regexp transcript (?i)^/api/v1/sessions/[^/]+/transcript$
	@rest {
		not path_regexp (?i)^/api/v1/projects/[^/]+/media/[0-9]+$
		not path_regexp (?i)^/api/v1/sessions/[^/]+/transcript$
		not path /api/ext/*
	}
	request_body @video {
		max_size 201MiB
	}
	request_body @transcript {
		max_size 65MiB
	}
	request_body @rest {
		max_size 9MiB
	}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy 127.0.0.1:4390 {
		# Caddy replaces client-supplied X-Forwarded-For unless the client is a
		# trusted proxy; the app trusts only this loopback hop (TRUST_PROXY).
		header_up X-Forwarded-Proto https
	}
}

# Interactive HTML viewer: a separate registrable domain, only this runtime.
# Plain HTTP is refused without a Location, so no capability is redirected.
# ACME HTTP-01 challenges are still answered before this route.
http://{$VIEWER_HOST_NAME} {
	abort
}

{$VIEWER_HOST_NAME} {
	# Text is compressed (Caddy's default list: HTML, CSS, JavaScript, JSON,
	# SVG…); video and pictures are not, and a ranged response never is.
	encode zstd gzip
	# Cache-Control is the app's to set: no-store for a page built per view,
	# private with an ETag for a file of a saved version (project-viewer.ts).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy 127.0.0.1:4391 {
		# live-viewer.ts only accepts this fixed upstream authority
		# (VIEWER_HOST:VIEWER_PORT) and ignores forwarded authority.
		header_up Host 127.0.0.1:4391
		# The viewer never uses app credentials; do not forward them.
		header_up -Cookie
		header_up -Authorization
		header_down -Set-Cookie
		header_down -X-Frame-Options
	}
}

# Anything else (unknown Host on port 80) is dropped. Over TLS an unknown SNI
# has no certificate and strict_sni_host rejects a mismatched Host.
:80 {
	abort
}
