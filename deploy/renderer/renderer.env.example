# The renderer VM's settings (deploy/renderer/README.md). Copy to renderer.env
# (never committed) and fill in. Nothing else of Полка lives on this VM.

# The renderer's DNS name; Caddy gets a certificate for it.
RENDERER_HOST=renderer.polka.example.com
# The main VM's address as the renderer sees it (public, or internal within the VPC).
APP_VM_IP=
# Shared with the main VM's hosted.env (openssl rand -hex 32).
RENDERER_SECRET=
