# Copy to deploy/base.env and fill every required value out of band.
# Never commit deploy/base.env. POLKA_IMAGE must be an immutable digest.
POLKA_IMAGE=
SCHEMA_DATABASE_URL=
DATABASE_URL=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
LINK_KEY=
APP_ORIGIN=https://polka.example.com
COOKIE_SECURE=true
APP_PORT=4390
# Address(es)/CIDRs of your reverse proxy as seen by the app container, so
# rate limits use the real client IP from X-Forwarded-For. Leave empty when
# the app is reached directly (then the socket address is used).
TRUST_PROXY=
# disabled (static HTML only) is the only mode this bridge-network shape
# supports; the interactive viewer needs the loopback/host-network layout of
# deploy/hosted (see deploy/BASE.md). VIEWER_ORIGIN is then the https origin
# of a separate registrable domain, e.g. https://polka-viewer.example.net.
HTML_LIVE_MODE=disabled
# VIEWER_ORIGIN=
# Import by link (needs the full migration set); off by default.
URL_IMPORT_ENABLED=false
# Per-statement bound for the migration job (milliseconds).
# MIGRATION_STATEMENT_TIMEOUT_MS=120000
# Keep experimental account deletion off in this base candidate.
ACCOUNT_DELETION_ENABLED=false
# Optional SMTP overlay only; leave these commented while MAIL_MODE is disabled.
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@example.invalid
# invite (default): codes only for existing accounts and the entries below.
# EMAIL_SIGNUP=invite
# EMAIL_SIGNUP_ALLOW=anna@example.com,@team.example.com
# Where a NEW shelf may open by an emailed code: any | ru-only | domains.
# EMAIL_SIGNUP_DOMAINS=any
# EMAIL_LOGIN_DOMAINS=any
# Sign-in through a company's own IdP (OpenID Connect), docs/specs/SIGN_IN_PROVIDERS.md.
# Register redirect URI <APP_ORIGIN>/api/auth/idp/oidc/callback in the IdP.
# OIDC_DISCOVERY_URL=https://sso.example.com/realms/company/.well-known/openid-configuration
# OIDC_CLIENT_ID=polka
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Вход для сотрудников
# OIDC_ALLOWED_DOMAINS=example.com
# Everyone the IdP lets in joins this template library (reader|curator):
# OIDC_ORG_LIBRARY=00000000-0000-0000-0000-000000000000:reader
# Verified addresses of a domain join a library (Яндекс 360 companies via Яндекс ID):
# ORG_DOMAINS=example.com=00000000-0000-0000-0000-000000000000:reader
# Яндекс ID / VK ID: register <APP_ORIGIN>/api/auth/idp/yandex/callback and …/vk/callback.
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# VK_CLIENT_ID=
# on | owner-notes | off
# COMMENTS_MODE=on
