# Controlled staging example. Replace both placeholder names with two
# operator-controlled HTTPS origins on different registrable domains. This
# file does not install certificates or open a public listener by itself.

# nginx error messages can serialize request URLs before vhost selection.
# Keep URI-free access status logging; use metrics for operational errors.
error_log /dev/null emerg;
worker_processes 1;
events { worker_connections 256; }

http {
  log_format staging_safe '$request_id $status $request_method';
  access_log /var/log/nginx/staging.log staging_safe;
  proxy_cache off;
  proxy_buffering off;

  upstream polka_app { server 127.0.0.1:4390; }
  upstream polka_viewer { server 127.0.0.1:4391; }

  # Unknown HTTP hosts are rejected. In particular, do not redirect an HTTP
  # viewer request: a capability must never be carried through a redirect.
  server {
    listen 80 default_server;
    server_name _;
    return 444;
  }
  server {
    listen 80;
    server_name viewer.example-b.invalid;
    return 444;
  }
  server {
    listen 80;
    server_name app.example-a.invalid;
    return 301 https://app.example-a.invalid$request_uri;
  }

  server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 421;
  }
  server {
    listen 443 ssl;
    server_name app.example-a.invalid;
    # ssl_certificate and ssl_certificate_key are operator supplied.
    ssl_certificate /etc/nginx/tls/app/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/app/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    if ($ssl_server_name != app.example-a.invalid) { return 421; }
    if ($host != app.example-a.invalid) { return 421; }
    # Keep nginx above the application's 5 MiB upload / 8 MiB MCP limits.
    client_max_body_size 8m;
    location / {
      proxy_pass http://polka_app;
      proxy_set_header Host app.example-a.invalid;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host app.example-a.invalid;
      proxy_set_header X-Request-Id $request_id;
      # Overwrite (never append) so clients cannot spoof it; pair with TRUST_PROXY=127.0.0.1.
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_http_version 1.1;
    }
  }

  server {
    listen 443 ssl;
    server_name viewer.example-b.invalid;
    ssl_certificate /etc/nginx/tls/viewer/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/viewer/privkey.pem;
    access_log off;
    error_log /dev/null emerg;
    if ($ssl_server_name != viewer.example-b.invalid) { return 421; }
    if ($host != viewer.example-b.invalid) { return 421; }
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    location / {
      proxy_pass http://polka_viewer;
      proxy_set_header Host 127.0.0.1:4391;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Host viewer.example-b.invalid;
      proxy_set_header X-Request-Id $request_id;
      proxy_set_header Cookie "";
      proxy_set_header Authorization "";
      proxy_hide_header Set-Cookie;
      proxy_http_version 1.1;
    }
  }
}
