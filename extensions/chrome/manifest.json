{
  "manifest_version": 3,
  "name": "На Полку",
  "short_name": "На Полку",
  "version": "0.1.1",
  "description": "Сохраняет артефакты Claude и ChatGPT из вашего браузера на вашу Полку и выдаёт ссылку.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "На Полку",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["scripting", "storage", "identity"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claudeusercontent.com/*",
    "https://chatgpt.com/*",
    "https://polochka.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
