{
  "name": "polka",
  "version": "0.2.0",
  "description": "Полка: a private shelf for AI-made HTML artifacts, reports and files, with expiring share links.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artkruglov/polka.git"
  },
  "homepage": "https://polochka.app",
  "bugs": {
    "url": "https://github.com/artkruglov/polka/issues"
  },
  "private": true,
  "type": "module",
  "bin": {
    "polka-publish": "scripts/polka-publish.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx --env-file=.env apps/server/main.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "check": "npm run check:layers && tsc --noEmit && tsc --noEmit -p extensions/chrome",
    "ext:build": "tsc --noEmit -p extensions/chrome && node extensions/chrome/build.mjs",
    "test": "tsx --env-file=.env scripts/test-isolated.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "account:create": "tsx --env-file=.env scripts/account.ts",
    "account:email": "tsx --env-file=.env scripts/account-email.ts",
    "moderation:reports": "tsx --env-file=.env scripts/moderation.ts reports",
    "moderation:revoke-share": "tsx --env-file=.env scripts/moderation.ts revoke-share",
    "moderation:disable": "tsx --env-file=.env scripts/moderation.ts disable",
    "moderation:enable": "tsx --env-file=.env scripts/moderation.ts enable",
    "moderation:queue": "tsx --env-file=.env scripts/moderation.ts queue",
    "moderation:approve": "tsx --env-file=.env scripts/moderation.ts approve",
    "moderation:unpause": "tsx --env-file=.env scripts/moderation.ts unpause",
    "moderation:trust": "tsx --env-file=.env scripts/moderation.ts trust",
    "moderation:comments": "tsx --env-file=.env scripts/moderation.ts comments",
    "moderation:delete-comment": "tsx --env-file=.env scripts/moderation.ts delete-comment",
    "moderation:release-comment": "tsx --env-file=.env scripts/moderation.ts release-comment",
    "moderation:takedown": "tsx --env-file=.env scripts/moderation.ts takedown",
    "moderation:block": "tsx --env-file=.env scripts/moderation.ts block",
    "moderation:unblock": "tsx --env-file=.env scripts/moderation.ts unblock",
    "moderation:legal-hold": "tsx --env-file=.env scripts/moderation.ts legal-hold",
    "moderation:handed-over": "tsx --env-file=.env scripts/moderation.ts handed-over",
    "moderation:purge-artifact": "tsx --env-file=.env scripts/moderation.ts purge-artifact",
    "moderation:events": "tsx --env-file=.env scripts/moderation.ts events",
    "moderation:sweep": "tsx --env-file=.env scripts/moderation.ts sweep",
    "moderation:recheck": "tsx --env-file=.env scripts/moderation.ts recheck",
    "editorial:content-scan": "tsx scripts/editorial-content-scan.ts",
    "local:setup": "node scripts/local-setup.mjs",
    "infra:up": "docker compose --env-file=.env -f deploy/compose.local.yml up -d --wait",
    "infra:stop": "docker compose --env-file=.env -f deploy/compose.local.yml stop",
    "maintenance": "tsx --env-file=.env scripts/maintenance.ts",
    "metrics": "tsx --env-file=.env scripts/metrics.ts",
    "format": "prettier --write apps packages scripts/*.ts tests/*.ts",
    "test:restore-guards": "tsx --test tests/restore-drill.test.ts",
    "test:url-import-runtime": "tsx --env-file=.env scripts/test-url-import-runtime.ts",
    "test:url-import-restricted": "tsx --env-file=.env scripts/test-url-import-runtime.ts --restricted",
    "test:renderer-runtime": "tsx scripts/test-renderer-runtime.ts",
    "storage:bootstrap-local": "tsx --env-file=.env scripts/local-storage-bootstrap.ts --confirm-local-bootstrap",
    "maintenance:watch": "tsx --env-file=.env scripts/maintenance-runner.ts",
    "check:layers": "node scripts/check-frontend-layers.mjs",
    "check:links": "node scripts/check-doc-links.mjs",
    "gen:skill": "tsx --env-file=.env scripts/gen-skill.ts",
    "verify": "node scripts/verify.mjs",
    "test:live": "tsx --env-file=.env scripts/test-isolated.ts --live",
    "test:runtime-grants": "tsx --env-file=.env scripts/test-runtime-grants-isolated.ts --confirm-synthetic"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/fastify": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@smithy/node-http-handler": "4.12.1",
    "acorn": "8.18.0",
    "chart.js": "4.5.1",
    "d3": "7.9.0",
    "entities": "8.1.0",
    "esbuild": "0.28.2",
    "fastify": "5.12.4",
    "lodash": "4.18.1",
    "lucide-react": "1.45.0",
    "mathjs": "15.2.0",
    "nodemailer": "10.0.10",
    "papaparse": "5.7.0",
    "parse5": "8.0.1",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "saxes": "6.0.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.0",
    "tldts": "7.4.13",
    "tsx": "4.23.13",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.5.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.6",
    "rolldown": "1.2.8",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
