{
  "name": "polka",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "bin": {
    "polka-publish": "scripts/polka-publish.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx --env-file=.env apps/server/main.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "check": "npm run check:layers && tsc --noEmit",
    "test": "tsx --env-file=.env scripts/test-isolated.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "account:create": "tsx --env-file=.env scripts/account.ts",
    "local:setup": "node scripts/local-setup.mjs",
    "infra:up": "docker compose --env-file=.env -f deploy/compose.local.yml up -d --wait",
    "infra:stop": "docker compose --env-file=.env -f deploy/compose.local.yml stop",
    "maintenance": "tsx --env-file=.env scripts/maintenance.ts",
    "format": "prettier --write apps packages scripts/*.ts tests/*.ts",
    "test:restore-guards": "tsx --test tests/restore-drill.test.ts",
    "test:trash": "HTML_LIVE_ENABLED=true VIEWER_ORIGIN=http://localhost:4391 VIEWER_HOST=localhost VIEWER_PORT=4391 tsx --env-file=.env --test tests/trash.test.ts",
    "test:live": "HTML_LIVE_ENABLED=true VIEWER_ORIGIN=http://localhost:4391 VIEWER_HOST=localhost VIEWER_PORT=4391 tsx --env-file=.env --test tests/live-viewer.test.ts",
    "test:runtime": "HTML_LIVE_ENABLED=true VIEWER_ORIGIN=http://localhost:4391 VIEWER_HOST=localhost VIEWER_PORT=4391 tsx --env-file=.env --test tests/bundle-runtime.test.ts",
    "test:url-import-runtime": "tsx --env-file=.env scripts/test-url-import-runtime.ts",
    "test:url-import-restricted": "tsx --env-file=.env scripts/test-url-import-runtime.ts --restricted",
    "test:service-auth": "tsx --env-file=.env --test tests/service-auth.test.ts",
    "test:mcp": "APP_ORIGIN=http://127.0.0.1:4590 HOST=127.0.0.1 PORT=4590 COOKIE_SECURE=false HTML_LIVE_ENABLED=true tsx --env-file=.env --test tests/mcp-transport.test.ts",
    "storage:bootstrap-local": "tsx --env-file=.env scripts/local-storage-bootstrap.ts --confirm-local-bootstrap",
    "maintenance:watch": "tsx --env-file=.env scripts/maintenance-runner.ts",
    "test:editorial-catalog": "HTML_LIVE_ENABLED=true VIEWER_ORIGIN=http://localhost:4391 VIEWER_HOST=localhost VIEWER_PORT=4391 tsx --env-file=.env --test tests/editorial-catalog.test.ts",
    "check:layers": "node scripts/check-frontend-layers.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/fastify": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@smithy/node-http-handler": "4.12.1",
    "chart.js": "4.5.1",
    "d3": "7.9.0",
    "esbuild": "0.28.2",
    "fastify": "5.12.4",
    "lodash": "4.18.1",
    "lucide-react": "1.45.0",
    "mathjs": "15.2.0",
    "nodemailer": "^10.0.10",
    "papaparse": "5.7.0",
    "parse5": "8.0.1",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "saxes": "6.0.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.0",
    "tldts": "7.4.13",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.5.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.6",
    "rolldown": "1.2.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
