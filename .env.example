# Prefer `npm run local:setup`: it generates unique local secrets.
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://polka:replace-with-a-random-password@127.0.0.1:54388/polka
S3_ENDPOINT=http://127.0.0.1:9038
S3_ACCESS_KEY=polka-local
S3_SECRET_KEY=replace-with-a-random-secret
S3_BUCKET=polka-local
LINK_KEY=replace-with-at-least-64-random-characters-and-keep-between-restarts
APP_ORIGIN=http://127.0.0.1:4390
HOST=127.0.0.1
PORT=4390
COOKIE_SECURE=false
