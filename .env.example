# Prefer `npm run local:setup`: it generates unique local secrets.
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://polka:replace-with-a-random-password@127.0.0.1:54388/polka
S3_ENDPOINT=http://127.0.0.1:9038
S3_ACCESS_KEY=polka-local
S3_SECRET_KEY=replace-with-a-random-secret
S3_BUCKET=polka-local
LINK_KEY=replace-with-at-least-64-random-characters-and-keep-between-restarts
APP_ORIGIN=http://127.0.0.1:4390
HOST=127.0.0.1
PORT=4390
COOKIE_SECURE=false

# disabled (default), local (.test addresses, loopback only), or smtp
MAIL_MODE=disabled
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=hello@example.com

# Local experiment only; hosted activation is rejected until runtime acceptance.
HTML_LIVE_ENABLED=false
VIEWER_ORIGIN=http://localhost:4391
VIEWER_HOST=localhost
VIEWER_PORT=4391

# Incomplete local R17 experiment: access revocation only, no automatic purge.
# Keep disabled for real users. Policy targets are not cleanup guarantees.
ACCOUNT_DELETION_ENABLED=false
# Required only for explicit local testing when enabled:
# ACCOUNT_PURGE_MAX_HOURS=       # integer 1..8760, chosen by the operator
# BACKUP_RETENTION_MAX_DAYS=    # integer 0..3650; 0 means explicitly no backups
# ACCOUNT_DELETION_POLICY_VERSION=

# Requires schema migration 019; standalone HTML only, provider artifacts unsupported.
URL_IMPORT_ENABLED=false
