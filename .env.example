# Prefer `npm run local:setup`: it generates unique local secrets.
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://polka:replace-with-a-random-password@127.0.0.1:54388/polka
S3_ENDPOINT=http://127.0.0.1:9038
S3_ACCESS_KEY=polka-local
S3_SECRET_KEY=replace-with-a-random-secret
S3_BUCKET=polka-local
LINK_KEY=replace-with-at-least-64-random-characters-and-keep-between-restarts
APP_ORIGIN=http://127.0.0.1:4390
HOST=127.0.0.1
PORT=4390
COOKIE_SECURE=false

# Source code offered to users (AGPL-3.0 § 13). A modified Полка served to
# others must point at its modified source. Unset: the upstream repository.
# SOURCE_URL=https://github.com/artkruglov/polka

# disabled (default), local (.test addresses, loopback only), or smtp
MAIL_MODE=disabled
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=hello@example.com

# Reverse proxies whose X-Forwarded-For is trusted (comma-separated
# addresses/CIDRs). Empty for local development: the socket address is used.
TRUST_PROXY=

# Interactive HTML viewer: disabled | local | staging | production.
# local = this machine only: APP_ORIGIN and VIEWER_ORIGIN must be plain-HTTP
# loopback origins with opposite hostnames (127.0.0.1 vs localhost) and ports
# matching PORT / VIEWER_PORT. staging/production need two HTTPS origins on
# different registrable domains and loopback listeners behind a reverse proxy
# (see deploy/hosted). Unset means disabled; HTML_LIVE_ENABLED=true is the
# legacy spelling of local and must not be combined with another mode.
# HTML_LIVE_MODE=disabled
VIEWER_ORIGIN=http://localhost:4391
VIEWER_HOST=localhost
VIEWER_PORT=4391

# Incomplete local R17 experiment: access revocation only, no automatic purge.
# Keep disabled for real users. Policy targets are not cleanup guarantees.
ACCOUNT_DELETION_ENABLED=false
# Required only for explicit local testing when enabled:
# ACCOUNT_PURGE_MAX_HOURS=       # integer 1..8760, chosen by the operator
# BACKUP_RETENTION_MAX_DAYS=    # integer 0..3650; 0 means explicitly no backups
# ACCOUNT_DELETION_POLICY_VERSION=

# Import by link: standalone HTML and GitHub Gist (official API); Claude,
# ChatGPT and other AI chats are never fetched by the server.
URL_IMPORT_ENABLED=false
# Optional GitHub token for gists: without it GitHub allows 60 requests an
# hour per IP. A fine-grained token with no permissions is enough.
# GITHUB_TOKEN=

# Official «На Полку» browser extension IDs (comma-separated). Their OAuth
# consent is labelled «Расширение браузера «На Полку»»; unset: every extension
# is shown with its ID and the name it declared (extensions/chrome/README.md).
# BROWSER_EXTENSION_IDS=
